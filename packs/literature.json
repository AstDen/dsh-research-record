{
  "id": "literature",
  "title": "Scientific literature",
  "kinds": {
    "extensions": {
      "ris": "bib",
      "enw": "bib",
      "nbib": "bib",
      "csl": "bib",
      "bibtex": "bib",
      "bib": "bib"
    },
    "names": {
      "library.bib": "bib",
      "references.bib": "bib"
    }
  },
  "dirs": [
    {
      "id": "refs",
      "role": "literature",
      "nameMatches": "^(refs|references|pdfs|papers|sources|articles|литература|статьи)$"
    },
    {
      "id": "notes",
      "role": "literature",
      "nameMatches": "^(notes|reading|cards|summaries|карточки|конспекты|заметки)$"
    }
  ],
  "match": {
    "files": [],
    "names": [
      "library.bib",
      "references.bib"
    ],
    "extensions": {
      "pdf": 10,
      "bib": 1
    }
  },
  "wording": {
    "run": "a pass over the corpus",
    "literature": "the set of sources",
    "analysis": "reading the sources"
  }
}
